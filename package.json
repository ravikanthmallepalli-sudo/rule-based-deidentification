{
  "name": "rule-based-deidentification",
  "version": "1.0.0",
  "description": "Rule-based text de-identification service: finds emails, phone numbers, SSNs, dates of birth, credit cards and IPv4 addresses with regular expressions and hand-written validation, and replaces them with placeholders.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/deidentify.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
